# Apology Archaeology environment configuration
# Copy this file to .env and adjust the values for local runs.
# All variables are optional unless marked REQUIRED.

# --- OpenAI ---
# REQUIRED: Your OpenAI API key.
OPENAI_API_KEY=sk-replace-with-your-openai-api-key

# Model used for JSON-mode extraction, scoring, and plaque copy.
OPENAI_MODEL=gpt-4o-mini

# Optional organization or project identifiers.
# OPENAI_ORG_ID=org-...
# OPENAI_PROJECT_ID=proj-...

# Optional custom base URL for proxies or Azure-compatible endpoints.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Sampling and request behavior.
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1400
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF_SECONDS=2.0

# --- Ingestion ---
INGEST_ENCODING=utf-8
INGEST_TIMEZONE=UTC
INGEST_MAX_MESSAGE_CHARS=4000
INGEST_SKIP_EMPTY=true
INGEST_NORMALIZE_WHITESPACE=true

# --- Extraction ---
EXTRACT_MIN_CONFIDENCE=0.55
EXTRACT_MAX_EVENTS_PER_MESSAGE=3
EXTRACT_CONTEXT_WINDOW=2
EXTRACT_INCLUDE_CONTEXT=true
EXTRACT_LANGUAGE=english

# --- Clustering / stratified layers ---
CLUSTER_TIME_BUCKET_DAYS=7
CLUSTER_SIMILARITY_THRESHOLD=0.62
CLUSTER_MIN_EVENTS=1
CLUSTER_MAX_LAYERS=25
CLUSTER_TONE_WEIGHT=0.35
CLUSTER_TOPIC_WEIGHT=0.35
CLUSTER_TIME_WEIGHT=0.30

# --- Sincerity scoring ---
SCORE_WEIGHT_LINGUISTIC=0.40
SCORE_WEIGHT_CONTEXTUAL=0.30
SCORE_WEIGHT_REPETITION=0.30
SCORE_OVERUSE_PENALTY=0.15
SCORE_MAX_REPETITIONS=5
SCORE_SCALE_MIN=0
SCORE_SCALE_MAX=100

# --- Badges ---
BADGE_MIN_OCCURRENCES=3
BADGE_MIN_SPAN_DAYS=30
BADGE_MAX_BADGES=8
BADGE_TOPICS=work,relationships,health,finances,logistics,communication

# --- Plaque ---
PLAQUE_TEMPLATE=assets/plaque_template.html
PLAQUE_OUTPUT_FILENAME=apology_plaque.html
PLAQUE_MAX_TITLE_CHARS=80
PLAQUE_MAX_EXCERPT_CHARS=220
PLAQUE_MAX_BADGES=5
PLAQUE_INCLUDE_QR=true
PLAQUE_QR_URL=https://example.com/apology-archaeology
PLAQUE_FONT_FAMILY=Georgia, 'Times New Roman', serif

# --- Output / reports ---
OUTPUT_DIR=output
REPORT_FORMATS=json,csv,txt
REPORT_PRETTY_JSON=true
REPORT_INCLUDE_RAW=true
CSV_QUOTE_ALL=true
LOG_LEVEL=INFO